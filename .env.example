# Database (Postgres connection string)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Auth
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
CORS_ORIGIN="http://localhost:8080"

# GenAI. Options: mock | groq | gemini | openai | anthropic
# "mock" needs no API key.
AI_PROVIDER="mock"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GEMINI_API_KEY=""
GEMINI_MODEL=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5"

# Optional: webhook for n8n
N8N_WEBHOOK_URL=""

# Demo account created by npm run db:seed
DEMO_EMAIL="demo@brandvault.dev"
DEMO_PASSWORD="Demo1234!"